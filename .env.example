# astrolabe-server configuration. Copy to .env and fill in; never commit .env.

# Neon connection string (Neon console → your project → Connect).
# Keep sslmode=require. If your Neon string has channel_binding=require, remove that part.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Shared secret the CLI sends with --api-key when uploading scans.
ASTROLABE_API_KEY=change-me

PORT=8080
