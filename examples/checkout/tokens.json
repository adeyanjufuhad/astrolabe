{
  "color": {
    "$type": "color",
    "blue": {
      "500": { "$value": "#3b82f6" },
      "600": { "$value": "#2563eb" }
    },
    "gray": {
      "50":  { "$value": "#f9fafb" },
      "200": { "$value": "#e5e7eb" },
      "500": { "$value": "#6b7280" },
      "900": { "$value": "#111827" }
    },
    "white":   { "$value": "#ffffff" },
    "green":   { "$value": "#16a34a" },
    "primary": { "$value": "{color.blue.500}" },
    "text":    { "$value": "{color.gray.900}" },
    "muted":   { "$value": "{color.gray.500}" },
    "border":  { "$value": "{color.gray.200}" },
    "surface": { "$value": "{color.gray.50}" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "2xl": { "$value": "24px" }
    },
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  }
}
